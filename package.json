{
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.1.0",
    "expo": "54.0.36",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "^0.32.17",
    "expo-screen-orientation": "~9.0.9",
    "expo-updates": "29.0.19",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7"
  },
  "name": "schedule-app",
  "version": "1.0.0",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "npx expo start",
    "start:clear": "npx expo start --clear",
    "start:dev": "npx expo start --dev-client",
    "android": "npx expo run:android --app-id com.favit.dev",
    "ios": "npx expo run:ios",
    "prebuild": "npx expo prebuild",
    "check:android-config": "node scripts/check-android-config.js",
    "check:contrast": "node scripts/check-color-contrast.js",
    "check:dependencies": "node scripts/check-dependency-audit.js",
    "check:project": "npm run test:domain && npm run check:android-config && npm run check:dependencies && npx --yes expo-doctor@1.20.1",
    "test:domain": "node scripts/check-hook-declaration-order.js && node scripts/test-domain-rules.js && node scripts/check-color-contrast.js",
    "update:preview": "npx eas update --channel preview",
    "update:production": "npx eas update --channel production"
  }
}
