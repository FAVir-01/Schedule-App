{
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.12",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.10",
    "expo-screen-orientation": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7"
  },
  "name": "schedule-app",
  "version": "1.0.0",
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "scripts": {
    "start": "npx expo start",
    "start:clear": "npx expo start --clear",
    "start:dev": "npx expo start --dev-client",
    "android": "npx expo run:android --app-id com.favit.dev",
    "ios": "npx expo run:ios",
    "prebuild": "npx expo prebuild",
    "check:android-config": "node scripts/check-android-config.js",
    "check:contrast": "node scripts/check-color-contrast.js",
    "check:dependencies": "node scripts/check-dependency-audit.js",
    "check:project": "npm run test:domain && npm run check:android-config && npm run check:dependencies && npx --yes expo-doctor@1.20.1",
    "test:domain": "node scripts/check-hook-declaration-order.js && node scripts/test-domain-rules.js && node scripts/check-color-contrast.js",
    "update:preview": "npx eas update --channel preview",
    "update:production": "npx eas update --channel production"
  }
}
